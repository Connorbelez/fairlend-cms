# Database connection string
POSTGRES_URL=postgresql://127.0.0.1:5432/your-database-name
# Optional Vercel Neon alias used by non-Payload app code. POSTGRES_URL is used as fallback.
DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name
# Search discovery. Generate one random 8-128 character key and set it only in
# production. The app serves it at /indexnow-key.txt and notifies IndexNow after
# published Pages and Posts change or are removed.
INDEXNOW_KEY=
# Optional local/test override. Production enables automatically when a valid key exists.
INDEXNOW_ENABLED=false
# Twenty CRM mirror and Codex MCP. Create a role-scoped key under Twenty
# Settings -> APIs & Webhooks and keep it server-side and out of Git.
TWENTY_SYNC_ENABLED=false
TWENTY_API_URL=https://api.twenty.com
TWENTY_API_KEY=
# Optional reconciliation batch size (1-1000). Twenty Cloud allows 100 requests/minute.
TWENTY_RECONCILE_LIMIT=100
# Payload's Postgres adapter pulls and pushes schema automatically in dev when enabled.
# Keep this false/blank for remote Neon or production-like databases; use migrations instead.
# Set PAYLOAD_DB_PUSH=true only when pointing at a disposable local database.
PAYLOAD_DB_PUSH=false
# Private server-side key for Google Places address autocomplete.
# The key's Google Cloud project must have Places API (New) enabled.
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
# Google Calendar sync for consultation booking.
# Share the target calendar with GOOGLE_CALENDAR_SERVICE_ACCOUNT_EMAIL.
GOOGLE_CALENDAR_ID=primary-or-calendar-id@group.calendar.google.com
GOOGLE_CALENDAR_SERVICE_ACCOUNT_EMAIL=fairlend-booking@your-project.iam.gserviceaccount.com
GOOGLE_CALENDAR_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
# Public Microsoft Bookings page used by the website consultation scheduler.
NEXT_PUBLIC_MICROSOFT_BOOKINGS_URL=https://outlook.office.com/book/FairLend1@fairlend.ca/?ismsaljsauthenabled

# Analytics and retargeting.
# Optional tracking is consent-gated by default. Set NEXT_PUBLIC_ANALYTICS_REQUIRE_CONSENT=false
# only after legal/compliance approves loading analytics and ad tags without an opt-in banner.
NEXT_PUBLIC_ANALYTICS_DISABLED=false
NEXT_PUBLIC_ANALYTICS_REQUIRE_CONSENT=true
NEXT_PUBLIC_ANALYTICS_DEBUG=false
# PostHog cloud project token and ingestion host.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Google Tag Manager / GA4 / Google Ads. GTM is optional but recommended for campaign tags.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_CONVERSION_LABEL=
# Retargeting pixels. Add only for platforms you actively use.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_LINKEDIN_LEAD_CONVERSION_ID=
NEXT_PUBLIC_MICROSOFT_UET_TAG_ID=

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE
# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE
# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE
