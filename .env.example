# Database connection string
POSTGRES_URL=postgresql://127.0.0.1:5432/your-database-name
# Optional Vercel Neon alias used by non-Payload app code. POSTGRES_URL is used as fallback.
DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name
# Payload's Postgres adapter pulls and pushes schema automatically in dev when enabled.
# Keep this false/blank for remote Neon or production-like databases; use migrations instead.
# Set PAYLOAD_DB_PUSH=true only when pointing at a disposable local database.
PAYLOAD_DB_PUSH=false
# Private server-side key for Google Places address autocomplete.
# The key's Google Cloud project must have Places API (New) enabled.
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
# Google Calendar sync for consultation booking.
# Share the target calendar with GOOGLE_CALENDAR_SERVICE_ACCOUNT_EMAIL.
GOOGLE_CALENDAR_ID=primary-or-calendar-id@group.calendar.google.com
GOOGLE_CALENDAR_SERVICE_ACCOUNT_EMAIL=fairlend-booking@your-project.iam.gserviceaccount.com
GOOGLE_CALENDAR_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
# Public Microsoft Bookings page used by the website consultation scheduler.
NEXT_PUBLIC_MICROSOFT_BOOKINGS_URL=https://outlook.office.com/book/FairLend1@fairlend.ca/?ismsaljsauthenabled
# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE
# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE
# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE
